#include <bits/stdc++.h>
using namespace std;
void printMatrix(vector<vector<int> > &arr){
    for(int i=0;i<arr.size();i++){
        for(int j=0;j<arr[i].size();j++){
            cout<<arr[i][j]<<" ";
        }
        cout<<endl;
    }
}
// WAP to print the row number having the maximum sum in a given matrix
void maxRowSum(vector<vector<int> > &arr){
    int rowIdx = 0;
    int maxRowSum = 0;
    for(int i=0;i<arr.size();i++){
        int rowSum = 0;
        for(int j=0;j<arr[0].size();j++){
            rowSum += arr[i][j];
        }
        if(rowSum > maxRowSum){
            maxRowSum = rowSum;
            rowIdx = i;
        }
    }
    cout<<"Row having the maximum sum is : "<<rowIdx<<" And the sum is equal to : "<<maxRowSum;
}
int main() {
    int row,col;
    cin>>row>>col;
    vector<vector<int> > arr(row, vector<int>(col));
    for(int i=0;i<arr.size();i++){
        for(int j=0;j<arr[i].size();j++){
            cin>>arr[i][j];
        }
    }
    printMatrix(arr);
    maxRowSum(arr);


    /*
    Input:  5 4
            2 3 1 4
            2 9 8 7
            11 7 2 3
            41 29 32 56 
            1 7 -7 4
    Output: 3  158
    */
}  
